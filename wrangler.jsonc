{
  // Despliegue en Cloudflare Workers: el sitio son archivos estáticos (out/)
  // y worker/index.js solo atiende /api/* (formulario de cotización).
  // `npm run build` genera out/ y `npm run deploy` lo sube.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ingeniatex",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Dominios del sitio. Al desplegar, Cloudflare crea los registros DNS y el
  // certificado. El nombre no debe tener registros A/AAAA/CNAME previos.
  // El canónico es www (SITE_URL en components/data/site.jsx); la redirección
  // ingeniatex.com → www se configura en la zona (Rules → Redirect Rules).
  "routes": [
    { "pattern": "ingeniatex.com", "custom_domain": true },
    { "pattern": "www.ingeniatex.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Solo /api/* pasa por el Worker; todo lo demás se sirve directo de out/.
    "run_worker_first": ["/api/*"],
    // /about sirve about.html; /about.html redirige a /about.
    "html_handling": "auto-trailing-slash",
    // Rutas inexistentes (incluida /services) responden 404.html con status 404.
    "not_found_handling": "404-page"
  },
  // Correo de las cotizaciones (Cloudflare Email Routing). La dirección tiene
  // que estar verificada en Email Routing → Destination addresses.
  "send_email": [
    { "name": "EMAIL", "destination_address": "ypz.omar@gmail.com" }
  ],
  "observability": { "enabled": true },
  // Vistas previas (builds de ramas que no son main, vía `wrangler preview`).
  // No heredan los bindings de arriba: hay que repetirlos aquí.
  "previews": {
    "send_email": [
      { "name": "EMAIL", "destination_address": "ypz.omar@gmail.com" }
    ],
    "observability": { "enabled": true }
  }
  // Secreto requerido (no va en este archivo):
  //   TURNSTILE_SECRET_KEY → `npx wrangler secret put TURNSTILE_SECRET_KEY`
  //   En local va en .dev.vars (ver .dev.vars.example).
}
